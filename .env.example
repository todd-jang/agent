# cp .env.example .env 후 값 입력 (.env는 git에 커밋하지 마세요)
API_KEY=replace-with-a-long-random-secret
TAVILY_API_KEY=
MODEL_NAME=qwen2.5:7b
NUM_CTX=8192
LLM_TIMEOUT=300
TURNSTILE_SITE_KEY=0x4AAAAAAFuzLS8m44Bj8zzY
TURNSTILE_SECRET_KEY=

# --- 멀티 노드 (docker-compose.node.yml) ---
NODE_BIND_IP=0.0.0.0                           # 운영: 이 노드의 사설 IP
OLLAMA_NUM_PARALLEL=1

# --- 공유 PostgreSQL (선택). 비워두면 노드 로컬 SQLite 샘플을 사용 ---
DATABASE_URL=
# 예: DATABASE_URL=postgresql://agent_ro:AGENT_RO_PASSWORD@10.0.0.20:5432/shop

# --- DB 서버에서만 사용 (docker-compose.db.yml) ---
POSTGRES_PASSWORD=
AGENT_RO_PASSWORD=
DB_BIND_IP=127.0.0.1                           # 운영: DB 서버의 사설 IP
